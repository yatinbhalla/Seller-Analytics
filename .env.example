# Copy to .env and fill in.

# Gemini — powers "Ask your data", the insight digest and return-reason themes.
# The app works fully without it; the AI panels just say a key is missing.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: pin a model instead of using the built-in fallback chain.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Port for the API server. Unset, it derives the same way the listers do
# (PORT + 1 when a host assigns a web port, else 3003). 3001/3002 belong to the
# Meesho and Flipkart listers.
# API_PORT=3003

# Where the Flipkart lister keeps its product paths and SKU ledger. Read only —
# the analytics app never writes there.
LISTER_FLIPKART_DIR=F:/Claude/Flipkart
LISTER_MEESHO_DIR=F:/Claude/Meesho

# Nightly auto-download: where WhatsApp alerts go (country code + number, no +),
# e.g. 91XXXXXXXXXX for an Indian mobile.
ALERT_WHATSAPP_TO=
# The Meesho Supplier Panel's code for your account: the part after /fulfillment/ or
# /payouts/ in its page addresses (supplier.meesho.com/panel/v3/new/payouts/<code>/…).
MEESHO_PANEL_SLUG=
